{
  "name": "waretrack-backend",
  "version": "1.0.0",
  "description": "Backend of WareTrack Inventory Warehouse System",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client ci && npm --prefix client run build",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "flow": "node --env-file-if-exists=.env scripts/flow.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "author": "Prabir Singh",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-validator": "7.3.2",
    "firebase-admin": "14.5.0",
    "helmet": "8.3.0",
    "http-errors": "2.0.1",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.10.3",
    "morgan": "1.12.1",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.0"
  }
}
