PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/waretrack
# node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# log = print notifications in the terminal, fcm = send with Firebase
PUSH_DRIVER=log

# --- Firebase (optional: Google sign-in and PUSH_DRIVER=fcm) ---------------
# Pick ONE of the two below. Both are secrets; neither belongs in git.
# A path to the service-account JSON file. Use this locally.
GOOGLE_APPLICATION_CREDENTIALS=
# The same JSON, as one line. Use this on a host with no writable disk
# (Vercel), where a file path is not an option.
FIREBASE_SERVICE_ACCOUNT=

# --- The React console's Firebase web config -------------------------------
# Public identifiers, not secrets: they ship inside the browser bundle.
# Leave them empty and the "Continue with Google" button simply does not render.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
